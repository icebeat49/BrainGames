<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-to-device transfer, Android 12 and later.
    Decision (plan step 8): everything is kept, so a reinstall or a new phone brings back the
    settings, the language, the stats and the games in progress (files/datastore and files/saves).
    No include or exclude rules means the whole app data is included.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
